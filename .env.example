# Browser-safe configuration for a future dedicated Score Predictor Supabase backend.
# Legacy VITE_SUPABASE_* values are intentionally ignored by the application.
VITE_SCORE_PREDICTOR_SUPABASE_URL=
VITE_SCORE_PREDICTOR_SUPABASE_PUBLISHABLE_KEY=

# TanStack Start server configuration for the same dedicated backend.
# Legacy SUPABASE_* values are intentionally ignored by server-side application code.
SCORE_PREDICTOR_SUPABASE_URL=
SCORE_PREDICTOR_SUPABASE_SERVICE_ROLE_KEY=
SCORE_PREDICTOR_SUPABASE_SECRET_KEY=

# Optional global key. A signed-in user can instead add a personal key in Configuration IA.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_MODEL=gpt-5.6-sol

# Server/Edge worker secrets — never prefix these with VITE_.
SPORTS_PROVIDER_API_KEY=
PREDICTION_ENGINE_SHARED_SECRET=
FIRECRAWL_API_KEY=

# Future Supabase deployment only. Configure this only after a new dedicated backend
# has been provisioned and reviewed; no deployment workflow is active by default.
SUPABASE_ACCESS_TOKEN=
SCORE_PREDICTOR_SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
